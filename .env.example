EMP_ADMIN_EMAIL=emp.administration@gmail.com

# ==========================================
# Option 1 : EmailJS (Recommandé, simple & gratuit)
# ==========================================
# 1. Créez un compte sur https://dashboard.emailjs.com/
# 2. Dans "Email Services" : ajoutez votre service Gmail (notez le SERVICE_ID, ex: service_abc123)
# 3. Dans "Email Templates" : créez un modèle avec les variables (notez le TEMPLATE_ID, ex: template_xyz456)
#    Variables disponibles : {{from_name}}, {{from_email}}, {{telephone}}, {{type}}, {{filiere}}, {{niveau}}, {{sujet}}, {{message}}
# 4. Dans "Account" > "Public Key" : copiez votre clé publique (PUBLIC_KEY, ex: user_789...)
#
NEXT_PUBLIC_EMAILJS_SERVICE_ID=votre_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=votre_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=votre_public_key

# ==========================================
# Option 2 : SMTP Gmail direct (Alternative)
# ==========================================
# SMTP_SERVICE=gmail
# SMTP_USER=emp.administration@gmail.com
# SMTP_PASS=votre_mot_de_passe_d_application_16_caracteres
